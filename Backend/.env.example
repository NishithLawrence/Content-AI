# OpenAI API Key (Preferred)
OPENAI_API_KEY=

# Optional: Gemini API Key if using Google AI Studio
GEMINI_API_KEY=

# Model Selection (Default: gpt-4o-mini or gemini-2.5-flash)
AI_MODEL_NAME=

# Optional: Custom OpenAI Base URL or Gemini OpenAI-compatible Base URL
OPENAI_BASE_URL=

# Production Allowed Origins for CORS (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173

# Optional: Mock mode for testing without API costs (true/false)
AI_USE_MOCK=false
